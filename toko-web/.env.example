# Salin file ini menjadi .env lalu isi nilainya.

# Database. Lokal: SQLite (otomatis dibuat). Online: isi dengan MySQL/PostgreSQL dari hosting.
#   MySQL      : mysql+pymysql://user:password@host:3306/nama_db
#   PostgreSQL : postgresql+psycopg://user:password@host:5432/nama_db
DATABASE_URL=sqlite:///./toko.db

# Info toko (tampil di web dan dipakai robot)
NAMA_TOKO=Yufasya Family
WHATSAPP=089527905336
ALAMAT_TOKO=Pasar Pariaman, depan stasiun kereta api
JAM_BUKA=Setiap hari mulai jam 07.00
# Nama pemilik (tampil di halaman selamat datang)
NAMA_PEMILIK=Papa
# Lokasi untuk Google Maps. Ganti dengan nama tempat di Google Maps atau koordinat "lat,lng" lapak.
MAPS_QUERY=-0.62680,100.11710
# Rekening tujuan transfer bank. Boleh lebih dari satu, dipisah koma, format Bank:Nomor (kosongkan untuk
# sembunyikan pilihan transfer bank, pembeli tetap bisa bayar QRIS).
# Contoh: REKENING_NAMA=Nama Papa
#         REKENING_BANKS=BRI:1234567890,BCA:0987654321,MANDIRI:111222333,BNI:444555666
# Beda nama pemilik per bank? pakai Bank:Nomor:Nama untuk bank itu.
REKENING_NAMA=
REKENING_BANKS=

# Aturan jualan
MIN_KG=1
DISKON_MIN_KG=5
DISKON_PERSEN=5

# Login halaman admin (/admin). WAJIB diganti sebelum online.
ADMIN_PASSWORD=ganti-password-ini
# Kunci acak untuk cookie login. Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-kunci-acak
# Isi 1 begitu web sudah online pakai HTTPS (wajib untuk keamanan login admin). Biarkan 0 untuk
# development lokal di http://localhost, kalau tidak browser akan menolak cookie login.
COOKIE_SECURE=0

# PIN yang harus disebut ke robot sebelum robot mau membacakan laporan penjualan.
# Wajib diisi: kalau kosong, robot menolak membacakan laporan.
PIN_LAPORAN=1234

# MCP endpoint dari Xiaozhi Console (Agents -> Configure -> MCP endpoint).
# Kalau diisi, web otomatis menyambung ke robot saat dijalankan.
MCP_ENDPOINT=

# Notifikasi WhatsApp saat ada chat baru dari web, lewat gateway Fonnte (fonnte.com).
# Isi dengan token perangkat dari dashboard Fonnte. Kalau kosong, chat tetap masuk ke /admin/chat.
WA_NOTIF_TOKEN=
# Nomor penerima notifikasi. Kosongkan untuk memakai nomor WHATSAPP di atas.
WA_NOTIF_TUJUAN=

# Password the robot uses when it reports to /api/robot/laporan.
# Must match TOKO_LAPOR_TOKEN in the firmware's main/toko_lapor_config.h.
ROBOT_TOKEN=

# Jam berapa laporan penjualan harian otomatis dikirim lewat WhatsApp (pakai WA_NOTIF_TOKEN di atas).
JAM_LAPORAN=20:00

# Ongkir otomatis berdasar jarak (opsional). Butuh API key Google Maps Distance Matrix dengan billing
# aktif di https://console.cloud.google.com/google/maps-apis - kalau kosong, ongkir tetap dihitung
# manual oleh admin di /admin/pesanan seperti biasa.
GOOGLE_MAPS_API_KEY=
ONGKIR_PER_KM=2000
